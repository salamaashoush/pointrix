{
  "name": "pointrix",
  "version": "1.1.0",
  "description": "Ultra-fast, minimal drag/resize/gesture library. The smallest and fastest interactable elements library.",
  "keywords": [
    "drag",
    "draggable",
    "drop",
    "dropzone",
    "fast",
    "gesturable",
    "gesture",
    "interact",
    "minimal",
    "pinch",
    "pointer",
    "resizable",
    "resize",
    "rotate",
    "sortable",
    "tiny",
    "touch",
    "zero-dependency"
  ],
  "homepage": "https://github.com/salamaashoush/pointrix#readme",
  "bugs": {
    "url": "https://github.com/salamaashoush/pointrix/issues"
  },
  "license": "MIT",
  "author": "salamaashoush@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/salamaashoush/pointrix"
  },
  "files": [
    "dist/**/*.mjs",
    "dist/**/*.cjs",
    "dist/**/*.d.mts",
    "dist/**/*.d.cts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/pointrix.cjs",
  "module": "dist/pointrix.mjs",
  "types": "dist/pointrix.d.mts",
  "exports": {
    ".": {
      "types": "./dist/pointrix.d.mts",
      "import": "./dist/pointrix.mjs",
      "require": "./dist/pointrix.cjs"
    },
    "./nano": {
      "types": "./dist/pointrix-nano.d.mts",
      "import": "./dist/pointrix-nano.mjs",
      "require": "./dist/pointrix-nano.cjs"
    },
    "./drag": {
      "types": "./dist/pointrix-drag.d.mts",
      "import": "./dist/pointrix-drag.mjs",
      "require": "./dist/pointrix-drag.cjs"
    },
    "./resize": {
      "types": "./dist/pointrix-resize.d.mts",
      "import": "./dist/pointrix-resize.mjs",
      "require": "./dist/pointrix-resize.cjs"
    },
    "./gesture": {
      "types": "./dist/pointrix-gesture.d.mts",
      "import": "./dist/pointrix-gesture.mjs",
      "require": "./dist/pointrix-gesture.cjs"
    },
    "./dropzone": {
      "types": "./dist/pointrix-dropzone.d.mts",
      "import": "./dist/pointrix-dropzone.mjs",
      "require": "./dist/pointrix-dropzone.cjs"
    },
    "./sortable": {
      "types": "./dist/pointrix-sortable.d.mts",
      "import": "./dist/pointrix-sortable.mjs",
      "require": "./dist/pointrix-sortable.cjs"
    },
    "./modifiers": {
      "types": "./dist/pointrix-modifiers.d.mts",
      "import": "./dist/pointrix-modifiers.mjs",
      "require": "./dist/pointrix-modifiers.cjs"
    },
    "./react": {
      "types": "./dist/pointrix-react.d.mts",
      "import": "./dist/pointrix-react.mjs",
      "require": "./dist/pointrix-react.cjs"
    },
    "./vue": {
      "types": "./dist/pointrix-vue.d.mts",
      "import": "./dist/pointrix-vue.mjs",
      "require": "./dist/pointrix-vue.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "demo": "vite",
    "bench": "vitest bench",
    "bench:browser": "BENCH=1 playwright test",
    "size": "bun run build && gzip -k dist/pointrix.mjs && ls -lh dist/pointrix.mjs dist/pointrix.mjs.gz && rm dist/pointrix.mjs.gz",
    "size:check": "node scripts/size-check.mjs",
    "prepublishOnly": "bun run lint && bun run format:check && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "interactjs": "^1.10.27",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsdown": "^0.21.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
